#!/usr/bin/env bash
# ==============================================================================
#  🛰️  NBody Labs Security Range CLI
#
#  Usage:
#    ./range setup                Pre-flight environment check (Challenge 0x00)
#    ./range up [challenge_id]    Spin up a challenge (e.g. 0x01, 0x02; default: 0x01)
#    ./range down                 Stop and remove all running containers
#    ./range list                 List available challenges
#    ./range status               Show status of containers and active challenge
#    ./range reset [challenge_id] Wipe state and restart fresh
# ==============================================================================

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHALLENGES_DIR="${ROOT_DIR}/challenges"

normalize_id() {
    local raw="${1:-0x01}"
    # Strip optional hex prefix (e.g. 0x01 -> 01, 0x1 -> 01)
    raw="${raw#0x}"
    if [[ "$raw" =~ ^[0-9]$ ]]; then
        printf "%02d" "$raw"
    else
        printf "%s" "$raw"
    fi
}

find_challenge_dir() {
    local id="$1"
    for dir in "${CHALLENGES_DIR}/${id}"* "${CHALLENGES_DIR}/0x${id}"*; do
        if [ -d "$dir" ]; then
            echo "$dir"
            return 0
        fi
    done
    return 1
}

cmd_list() {
    echo "============================================================"
    echo "  🛰️  Available NBody Labs Challenges"
    echo "============================================================"
    if [ ! -d "$CHALLENGES_DIR" ]; then
        echo "  No challenges found in ${CHALLENGES_DIR}."
        return
    fi

    for dir in "$CHALLENGES_DIR"/*; do
        if [ -d "$dir" ]; then
            local base
            base="$(basename "$dir")"
            local conf="${dir}/config.env"
            local name="$base"
            local version="v1"
            if [ -f "$conf" ]; then
                # shellcheck source=/dev/null
                name="$(grep '^CHALLENGE_NAME=' "$conf" 2>/dev/null | cut -d'=' -f2 | tr -d '"' || echo "$base")"
                version="$(grep '^ORBIT_VERSION=' "$conf" 2>/dev/null | cut -d'=' -f2 | tr -d '"' || echo "v1")"
            fi
            printf "  • %-24s -> %s (Orbit %s)\n" "$base" "$name" "$version"
        fi
    done
    echo "============================================================"
}

is_hosted_model() {
    local base_url="${NBODY_OPENAI_BASE_URL:-}"
    local api_key="${OPENAI_API_KEY:-}"
    if [ -f "${ROOT_DIR}/.env" ]; then
        if [ -z "$base_url" ]; then
            base_url="$(grep -E '^\s*NBODY_OPENAI_BASE_URL\s*=' "${ROOT_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" | tr -d ' ' || true)"
        fi
        if [ -z "$api_key" ]; then
            api_key="$(grep -E '^\s*OPENAI_API_KEY\s*=' "${ROOT_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" | tr -d ' ' || true)"
        fi
    fi
    if [ -n "$base_url" ] && [ "$base_url" != "http://ollama:11434/v1" ] && [ "$base_url" != "http://ollama:11434" ]; then
        return 0
    fi
    if [ -n "$api_key" ] && [ "$api_key" != "ollama" ]; then
        return 0
    fi
    return 1
}

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "[-] Error: Docker CLI not found. Please install Docker & Docker Compose." >&2
        exit 1
    fi
    if ! docker info >/dev/null 2>&1; then
        echo "[-] Error: Docker daemon is not running. Please start Docker Desktop/daemon." >&2
        exit 1
    fi
    if ! docker compose version >/dev/null 2>&1; then
        echo "[-] Error: Docker Compose plugin not found. Please install docker-compose-plugin." >&2
        exit 1
    fi
}

cmd_setup() {
    echo "============================================================"
    echo "  🛰️  NBody Labs Range :: 0x00 Environment Pre-flight"
    echo "============================================================"
    local errors=0

    echo "[*] Checking Git..."
    if command -v git >/dev/null 2>&1; then
        echo "  [✓] Git is installed."
    else
        echo "  [✗] Git not found. Please install git."
        errors=$((errors + 1))
    fi

    echo "[*] Checking Docker..."
    if command -v docker >/dev/null 2>&1; then
        echo "  [✓] Docker CLI is installed."
        if docker info >/dev/null 2>&1; then
            echo "  [✓] Docker daemon is running."
        else
            echo "  [✗] Docker daemon is not running. Please start Docker Desktop/daemon."
            errors=$((errors + 1))
        fi
        if docker compose version >/dev/null 2>&1; then
            echo "  [✓] Docker Compose plugin is available."
        else
            echo "  [✗] Docker Compose plugin not found. Please install docker-compose-plugin."
            errors=$((errors + 1))
        fi
    else
        echo "  [✗] Docker CLI not found. Please install Docker & Docker Compose."
        errors=$((errors + 1))
    fi

    echo "[*] Checking Range Environment (.env)..."
    if [ -f "${ROOT_DIR}/.env" ]; then
        echo "  [✓] .env file detected."
        local model
        model="$(grep '^NBODY_MODEL=' "${ROOT_DIR}/.env" 2>/dev/null | cut -d'=' -f2 || echo "default")"
        echo "      Active Model: ${model}"
        if is_hosted_model; then
            echo "      Mode: Hosted Model Backend (Ollama will not be started)"
        else
            echo "      Mode: Local Model Backend (via Ollama)"
        fi
    else
        echo "  [i] No .env file found (using defaults from .env.example)."
        echo "      Run 'cp .env.example .env' to customize hosted LLM endpoints."
    fi

    echo ""
    echo "============================================================"
    if [ "$errors" -gt 0 ]; then
        echo "  [✗] Pre-flight check failed ($errors issue(s) found)."
        echo "  Please resolve the issues above before launching the range."
        echo "============================================================"
        return 1
    else
        echo "  [✓] Pre-flight check complete! All dependencies verified."
        echo "  Ready to launch Challenge 0x01:"
        echo "    ./range up 0x01"
        echo "============================================================"
        return 0
    fi
}

cmd_up() {
    local raw_id="${1:-0x01}"
    local id
    id="$(normalize_id "$raw_id")"

    if [ "$id" = "00" ] || [ "$id" = "0x00" ]; then
        cmd_setup
        return $?
    fi

    require_docker

    local cdir
    if ! cdir="$(find_challenge_dir "$id")"; then
        echo "[-] Error: Challenge '${raw_id}' (normalized: '${id}') not found in ${CHALLENGES_DIR}."
        echo "    Run './range list' to see available challenges."
        exit 1
    fi

    local cname
    cname="$(basename "$cdir")"
    local conf="${cdir}/config.env"

    echo "[*] Initializing ${cname}..."

    # Export configs from challenge env file if present
    if [ -f "$conf" ]; then
        set -a
        # shellcheck source=/dev/null
        source "$conf"
        set +a
    else
        export CHALLENGE_ID="$id"
        export ORBIT_VERSION="v1"
    fi

    # Fallback to OpenAI base URL if OPENAI_API_KEY is hosted but no base URL configured
    local api_key="${OPENAI_API_KEY:-}"
    local base_url="${NBODY_OPENAI_BASE_URL:-}"
    if [ -f "${ROOT_DIR}/.env" ]; then
        if [ -z "$api_key" ]; then
            api_key="$(grep -E '^\s*OPENAI_API_KEY\s*=' "${ROOT_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" | tr -d ' ' || true)"
        fi
        if [ -z "$base_url" ]; then
            base_url="$(grep -E '^\s*NBODY_OPENAI_BASE_URL\s*=' "${ROOT_DIR}/.env" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" | tr -d ' ' || true)"
        fi
    fi

    if [ -n "$api_key" ] && [ "$api_key" != "ollama" ]; then
        if [ -z "$base_url" ] || [ "$base_url" = "http://ollama:11434/v1" ] || [ "$base_url" = "http://ollama:11434" ]; then
            export NBODY_OPENAI_BASE_URL="https://api.openai.com/v1"
        fi
    fi

    # Build compose command
    local compose_args=("-f" "${ROOT_DIR}/docker-compose.yml")
    if [ -f "${cdir}/docker-compose.override.yml" ]; then
        compose_args+=("-f" "${cdir}/docker-compose.override.yml")
    fi

    if is_hosted_model; then
        echo "[*] Hosted model backend detected. Starting platform-api and agent (Ollama disabled)..."
        docker compose "${compose_args[@]}" up --build -d platform-api agent
    else
        echo "[*] Local model backend detected. Building and spinning up containers..."
        docker compose "${compose_args[@]}" --profile local up --build -d
    fi

    local port="${NBODY_PORT:-8080}"
    local api_port="${NBODY_API_PORT:-${CF_MOCK_PORT:-5050}}"
    local orbit_ver="${ORBIT_VERSION:-v1}"

    echo ""
    echo "============================================================"
    echo "  🛰️  NBody Labs Range :: ${cname}"
    echo "============================================================"
    echo "  Console:      http://127.0.0.1:${port}"
    echo "  Platform API: http://127.0.0.1:${api_port}"
    echo "  Target:       Orbit Infrastructure Co-pilot (${orbit_ver})"
    echo ""
    echo "  Scope & Details: See README.md"
    echo "  To stop:         ./range down"
    echo "============================================================"
}

cmd_down() {
    require_docker
    echo "[*] Stopping NBody Labs Range containers..."
    docker compose -f "${ROOT_DIR}/docker-compose.yml" --profile local down -v
    echo "[+] Range environment stopped and state cleaned."
}

cmd_status() {
    require_docker
    docker compose -f "${ROOT_DIR}/docker-compose.yml" --profile local ps
}

cmd_reset() {
    require_docker
    local id="${1:-0x01}"
    echo "[*] Resetting Challenge ${id}..."
    cmd_down
    cmd_up "$id"
}

# Main command router
COMMAND="${1:-up}"
shift || true

case "$COMMAND" in
    up)
        cmd_up "${1:-0x01}"
        ;;
    down|stop)
        cmd_down
        ;;
    list|ls)
        cmd_list
        ;;
    status|ps)
        cmd_status
        ;;
    reset|restart)
        cmd_reset "${1:-0x01}"
        ;;
    setup|check|preflight)
        cmd_setup
        ;;
    help|--help|-h)
        echo "Usage: ./range [setup|up|down|list|status|reset] [challenge_id]"
        ;;
    *)
        # If user runs `./range 0x01` or `./range 01` directly
        if [[ "$COMMAND" =~ ^(0x)?[0-9a-fA-F]+$ ]]; then
            cmd_up "$COMMAND"
        else
            echo "Unknown command: $COMMAND"
            echo "Usage: ./range [up|down|list|status|reset] [challenge_id]"
            exit 1
        fi
        ;;
esac
