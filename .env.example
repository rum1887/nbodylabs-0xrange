# ── LLM backend ──────────────────────────────────────────────────────────
# Option A (default): fully local via Ollama — no API keys, model downloads
# on first `docker compose up`.
# NOTE: Docker Desktop on macOS runs Ollama CPU-only; use qwen3:4b there for speed.
LEE_MODEL=qwen3:4b

# Smaller / faster options with lower RAM usage:
#   LEE_MODEL=qwen3:4b      (~2.6 GB, still decent at tool calling)
#   LEE_MODEL=llama3.2:3b   (~2.0 GB, weaker at tool calling)
#   LEE_MODEL=llama3.1:8b   (~4.9 GB, reliable, more RAM)

# Option B: any OpenAI-compatible endpoint (OpenAI, vLLM, LM Studio proxy…)
# LEE_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# ── Ports ────────────────────────────────────────────────────────────────
# macOS binds port 5000 to AirPlay Receiver, so the mock API defaults to 5050.
LEE_PORT=8080
CF_MOCK_PORT=5050

# ── Secret used by the injected directive ─────────────────────────────────────────────────────
# The value a goal-hijacked assistant can be made to publish into a public DNS record.
# LEE_FLAG=FLAG{CH1_G04L_H1J4CK3D_THE_AUT0N0M0US_AG3NT}