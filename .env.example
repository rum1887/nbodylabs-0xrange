# ── LLM backend ──────────────────────────────────────────────────────────
# Option A (default): fully local via Ollama — no API keys, model downloads
# on first `docker compose up`.
# NOTE: Docker Desktop on macOS runs Ollama CPU-only; use qwen3:4b there for speed.
NBODY_MODEL=qwen3:4b

# Smaller / faster options with lower RAM usage:
#   NBODY_MODEL=qwen3:4b      (~2.6 GB, still decent at tool calling)
#   NBODY_MODEL=llama3.2:3b   (~2.0 GB, weaker at tool calling)
#   NBODY_MODEL=llama3.1:8b   (~4.9 GB, reliable, more RAM)

# Option B: any OpenAI-compatible endpoint (OpenAI, vLLM, LM Studio proxy…)
# NBODY_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# ── Ports ────────────────────────────────────────────────────────────────
# macOS binds port 5000 to AirPlay Receiver, so the platform API defaults to 5050.
NBODY_PORT=8080
NBODY_API_PORT=5050
# CF_MOCK_PORT=5050  # Legacy compatibility alias

# ── Range challenge selection (defaults to 01) ─────────────────────────────
ORBIT_VERSION=v1
CHALLENGE_ID=01